{
  "version": "2.0.0",
  "tasks": [
    // Run once after cloning (Terminal > Run Task... > backend: install / frontend: install).
    { "label": "backend: install", "type": "npm", "script": "install", "path": "backend", "problemMatcher": [] },
    { "label": "frontend: install", "type": "npm", "script": "install", "path": "frontend", "problemMatcher": [] },
    // Postgres + Mailpit for local debugging (Mailpit UI: http://localhost:8025). Started by F5.
    {
      "label": "infra: db + mailpit",
      "type": "shell",
      "command": "docker compose --env-file .env.compose.dev --profile dev up -d --wait db mailpit",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "infra: stop",
      "type": "shell",
      "command": "docker compose --env-file .env.compose.dev --profile dev stop db mailpit",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
