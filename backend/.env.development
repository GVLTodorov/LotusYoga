# Local development only. Never used in production.
NODE_ENV=development
PORT=5080
HOST=127.0.0.1
DATABASE_URL=postgresql://lotus:lotus_dev_password@localhost:5432/lotusyoga?schema=public
JWT_SECRET=dev-only-jwt-secret-not-for-production-0123456789
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
# Mailpit (docker compose): SMTP 1025, web UI http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=LotusYoga <no-reply@lotusyoga.local>
# STATIC_DIR unset in dev: the Vite dev server serves the UI
ADMIN_EMAIL=admin@lotusyoga.local
ADMIN_PASSWORD=Admin-dev-password-1
JOBS_ENABLED=true
